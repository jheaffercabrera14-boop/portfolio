@model EditorDashboardViewModel
@{
    ViewData["Title"] = "Editor dashboard";
}
<h1 class="page-title">Editor <span class="accent">dashboard</span></h1>

<section class="panel">
    <div class="panel__head">
        <h2>Courses (@Model.Courses.Count)</h2>
        <a class="btn btn--small" asp-controller="EditorCourses" asp-action="Create">+ Add course</a>
    </div>
    @if (Model.Courses.Count == 0) { <p class="empty">No courses yet.</p> }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Code</th><th>Title</th><th>Units</th><th>Projects</th><th></th></tr></thead>
                <tbody>
                @foreach (var c in Model.Courses)
                {
                    <tr>
                        <td><span class="badge">@c.CourseCode</span></td>
                        <td>@c.CourseTitle</td>
                        <td>@c.Units</td>
                        <td>@c.ProjectCount</td>
                        <td class="row-actions">
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@c.CourseId">View</a>
                            <a asp-controller="EditorProjects" asp-action="Create" asp-route-courseId="@c.CourseId">+ Project</a>
                            <a asp-controller="EditorCourses" asp-action="Edit" asp-route-id="@c.CourseId">Edit</a>
                            <a class="danger" asp-controller="EditorCourses" asp-action="Delete" asp-route-id="@c.CourseId">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <div class="panel__head">
        <h2>Projects (@Model.Projects.Count)</h2>
        <a class="btn btn--small" asp-controller="EditorProjects" asp-action="Create">+ Add project</a>
    </div>
    @if (Model.Projects.Count == 0) { <p class="empty">No projects yet.</p> }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>Course</th><th>Title</th><th>Year</th><th>Images</th><th>Video</th><th></th></tr></thead>
                <tbody>
                @foreach (var p in Model.Projects)
                {
                    <tr>
                        <td><span class="badge">@p.CourseCode</span></td>
                        <td>@p.Title</td>
                        <td>@p.CompletedYear</td>
                        <td>@p.ImageCount</td>
                        <td>@(string.IsNullOrEmpty(p.VideoUrl) ? "–" : "Yes")</td>
                        <td class="row-actions">
                            <a asp-controller="Projects" asp-action="Details" asp-route-id="@p.ProjectId">View</a>
                            <a asp-controller="EditorProjects" asp-action="Edit" asp-route-id="@p.ProjectId">Edit</a>
                            <a class="danger" asp-controller="EditorProjects" asp-action="Delete" asp-route-id="@p.ProjectId">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
