@model HomeViewModel
@inject IConfiguration Config
@{
    ViewData["Title"] = "Home";
}
<section class="hero">
    <p class="hero__hello">Hello, I&rsquo;m</p>
    <h1 class="hero__name">@(Config["Portfolio:OwnerName"] ?? "Your Name")</h1>
    <p class="hero__tag">@Config["Portfolio:Tagline"]</p>
    <div class="hero__stats">
        <div><strong>@Model.Courses.Count</strong><span>courses</span></div>
        <div><strong>@Model.Projects.Count</strong><span>projects</span></div>
    </div>
    <a class="btn" asp-action="Index" asp-fragment="projects">Browse my work</a>
</section>

<section id="courses" class="section">
    <h2 class="section__title">My <span>courses</span></h2>
    @if (Model.Courses.Count == 0)
    {
        <p class="empty">No courses yet. Switch to Editor mode and add your first course.</p>
    }
    <div class="grid cards">
        @foreach (var c in Model.Courses)
        {
            <a class="card" asp-controller="Courses" asp-action="Details" asp-route-id="@c.CourseId">
                @if (!string.IsNullOrEmpty(c.ImageUrl))
                {
                    <img class="card__img" src="@c.ImageUrl" alt="@c.CourseTitle" loading="lazy" onerror="this.style.display='none'" />
                }
                else
                {
                    <div class="card__img card__img--empty">@c.CourseCode</div>
                }
                <div class="card__body">
                    <div class="card__meta"><span class="badge">@c.CourseCode</span><span>@c.Units unit(s)</span></div>
                    <h3 class="card__title">@c.CourseTitle</h3>
                    @if (!string.IsNullOrEmpty(c.AcademicTerm)) { <p class="card__text">@c.AcademicTerm</p> }
                    <span class="card__more">@c.ProjectCount project(s) &rarr;</span>
                </div>
            </a>
        }
    </div>
</section>

<section id="projects" class="section">
    <h2 class="section__title">My <span>projects</span></h2>
    @if (Model.Projects.Count > 0)
    {
        <div class="filters">
            <input id="project-search" class="input" type="search" placeholder="Search title, tech or course&hellip;" aria-label="Search projects" />
            <div class="chips">
                <button type="button" class="chip is-active" data-course="all">All</button>
                @foreach (var c in Model.Courses.Where(x => x.ProjectCount > 0))
                {
                    <button type="button" class="chip" data-course="@c.CourseId">@c.CourseCode</button>
                }
            </div>
        </div>
    }
    else
    {
        <p class="empty">No projects yet.</p>
    }
    <div class="grid cards" id="project-grid">
        @foreach (var p in Model.Projects)
        {
            <partial name="_ProjectCard" model="p" />
        }
    </div>
    <p id="no-results" class="empty" hidden>No project matches your search.</p>
</section>
