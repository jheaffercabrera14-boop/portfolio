@model LoginViewModel
@{
    ViewData["Title"] = "Editor sign in";
}
<section class="form-card narrow">
    <h1>Editor <span class="accent">sign in</span></h1>
    <p class="muted">Only the portfolio owner can add, edit or delete. Visitors can use the public pages without signing in.</p>
    <form asp-action="Login" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert--error"></div>
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="field">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" class="input" required maxlength="100" autocomplete="username" />
        </div>
        <div class="field">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" class="input" required maxlength="200" autocomplete="current-password" />
        </div>
        <button class="btn" type="submit">Sign in</button>
    </form>
</section>
